**/dist
**/.next
**/.turbo
**/coverage
**/test-results
**/playwright-report
**/*.tsbuildinfo
**/src/generated
.env
.env.*
**/*.pem
**/*.key
.vault-dev.json
docs
infra/compose/otel/out
infra/compose/seaweedfs/s3.json
apps/web/e2e
.tools
