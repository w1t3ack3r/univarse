# Local development environment. `pnpm db:setup` generates the DB entries in .env for you.
# Never commit .env. Production values come from the secret manager (docs/08-security.md §10).

# Platform (control plane) database
PLATFORM_DATABASE_URL=postgresql://univarse_app_platform:CHANGE_ME@127.0.0.1:5432/univarse_platform
PLATFORM_MIGRATOR_URL=postgresql://univarse_migrator:CHANGE_ME@127.0.0.1:5432/univarse_platform

# Tenant pool shard 01 (RLS-isolated)
TENANT_POOL_01_DATABASE_URL=postgresql://univarse_app:CHANGE_ME@127.0.0.1:5432/univarse_pool_01
TENANT_POOL_01_MIGRATOR_URL=postgresql://univarse_migrator:CHANGE_ME@127.0.0.1:5432/univarse_pool_01
