# Spec 0019: the stack's edge, as production's (docs/10 §3), on the stack's own names (*.stack.univarse.localhost, D6).
# PR B: HTTPS with UniVarse's name-constrained edge CA (B2): Caddy serves the one wildcard certificate `pnpm stack:init`
# issues and runs no CA of its own. Caddy listens on 8080 and 8443 inside its container (unprivileged); compose
# publishes them as 127.0.0.1:80 and 127.0.0.1:443.
{
	admin off
	# No automatic certificates, redirects or trust-store installs: the certificate is given, the redirect is below.
	auto_https off
	http_port 8080
	https_port 8443
}

# Every HTTPS site: the edge certificate, and B1's HSTS. `defer` sets the header as the response leaves, replacing
# what an upstream sent (the API's production value), so a response carries exactly one, without `preload`.
(edge) {
	tls /etc/caddy/tls/edge.crt /etc/caddy/tls/edge.key
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		defer
	}
}

# Mail (Mailpit's UI): read activation and reset codes without publishing Mailpit.
https://mail.stack.univarse.localhost:8443 {
	import edge
	reverse_proxy mailpit:8025
}

# Object storage: browsers upload and download here, presigned (spec 0010).
https://files.stack.univarse.localhost:8443 {
	import edge
	reverse_proxy seaweedfs:8333
}

# Every tenant: /api/* and /health/* to the API, everything else to the web app, as the dev edge routes (spec 0005 W2).
# Caddy sets X-Forwarded-For/-Host/-Proto itself, ignoring a client's own; the API trusts them only from Caddy and web.
https://*.stack.univarse.localhost:8443 {
	import edge
	@api path /api/* /health/*
	reverse_proxy @api api:8080
	reverse_proxy web:3000
}

# Plain HTTP only redirects, keeping the host and path (308 keeps the method).
http://*.stack.univarse.localhost:8080 {
	redir https://{host}{uri} 308
}
