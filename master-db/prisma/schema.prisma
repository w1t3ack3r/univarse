// Master Database Connection
// This is the central database for UniVarse platform management

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

// ============================================
// INSTITUTION STATUS
// ============================================

enum InstitutionStatus {
  PENDING              // Just created, not provisioned
  PROVISIONED          // DB created, awaiting activation
  ACTIVE               // Fully operational
  SUSPENDED            // Temporarily disabled (logins blocked)
  PENDING_DELETION     // 60-day deletion countdown started
  DELETED              // Soft deleted, data archived
}

// ============================================
// INSTITUTION REGISTRY
// ============================================

model Institution {
  id          String   @id @default(uuid())
  code        String   @unique  // "UNILAG", "OAU", "ABU"
  name        String            // "University of Lagos"
  subdomain   String   @unique  // "unilag" -> unilag.univarse.com
  logo        String?
  address     String?
  phone       String?
  email       String?
  website     String?
  
  // Database Connection Details
  dbHost      String   @default("localhost")
  dbPort      Int      @default(5432)
  dbName      String            // "univarse_unilag"
  dbUser      String            // "univarse_unilag_user"
  dbPassword  String            // Encrypted in production
  
  // Security
  tenantSecretKey     String?           // Unique 256-bit key for tenant
  keyCreatedAt        DateTime?
  keyRotatedAt        DateTime?
  
  // Status & Lifecycle
  status              InstitutionStatus @default(PENDING)
  isActive            Boolean           @default(true)  // Legacy, use status instead
  isProvisioned       Boolean           @default(false) // Legacy, use status instead
  
  // Deletion Workflow
  deletionRequestedAt DateTime?
  deletionScheduledAt DateTime?         // 60 days after request
  deletionWarningsSent Int              @default(0)     // Count of warnings sent
  deletionCancelledAt DateTime?
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("institutions")
}

// ============================================
// SUPER ADMIN (Platform-level admins)
// ============================================

model SuperAdmin {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  isActive  Boolean  @default(true)
  lastLoginAt DateTime?
  
  // Two-Factor Authentication
  twoFactorEnabled  Boolean  @default(false)
  twoFactorSecret   String?  // Encrypted TOTP secret
  twoFactorVerified Boolean  @default(false) // Has completed setup verification
  recoveryCodes     String[] @default([])    // Encrypted backup codes
  lastTwoFactorAt   DateTime?
  
  // IP Whitelisting
  ipWhitelist       String[] @default([])    // Empty = no restriction
  ipWhitelistEnabled Boolean @default(false)
  
  // Relations
  sessions          SuperAdminSession[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@map("super_admins")
}

// ============================================
// SUPER ADMIN SESSIONS (Active login sessions)
// ============================================

model SuperAdminSession {
  id            String   @id @default(uuid())
  superAdminId  String
  superAdmin    SuperAdmin @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  
  tokenHash     String   @unique  // Hash of JWT for revocation check
  ipAddress     String
  userAgent     String?
  deviceInfo    String?  // Parsed browser/OS info
  location      String?  // City, Country (from IP geolocation)
  
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  lastActivityAt DateTime @default(now())
  isActive      Boolean  @default(true)
  
  @@index([superAdminId])
  @@index([tokenHash])
  @@map("super_admin_sessions")
}


// ============================================
// AUDIT LOG (Platform-level actions)
// ============================================

model PlatformAuditLog {
  id            String   @id @default(uuid())
  action        String   // "CREATE_INSTITUTION", "PROVISION_DB", etc.
  description   String
  superAdminId  String?
  institutionId String?
  metadata      Json?
  ipAddress     String?
  userAgent     String?
  
  createdAt     DateTime @default(now())
  
  @@index([superAdminId])
  @@index([institutionId])
  @@map("platform_audit_logs")
}

// ============================================
// PLATFORM SETTINGS
// ============================================

enum SettingCategory {
  SECURITY
  TENANT_DEFAULTS
  EMAIL
  FEATURES
  BRANDING
  ANNOUNCEMENTS
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

model PlatformSetting {
  id          String          @id @default(uuid())
  key         String          @unique  // e.g., "security.sessionTimeout"
  value       String                   // Stored as string, parsed based on type
  type        SettingType     @default(STRING)
  category    SettingCategory
  label       String                   // Human-readable label
  description String?
  isPublic    Boolean         @default(false)  // Can be read by non-admins?
  
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  updatedBy   String?                  // SuperAdmin ID who last updated
  
  @@index([category])
  @@map("platform_settings")
}

// ============================================
// PLATFORM ANNOUNCEMENTS
// ============================================

model PlatformAnnouncement {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String   @default("info")  // info, warning, maintenance
  isActive    Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  targetRoles String[] @default([])      // Empty = all roles
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  
  @@map("platform_announcements")
}

// ============================================
// BROADCAST MESSAGES (Mass Communication)
// ============================================

model BroadcastMessage {
  id           String   @id @default(uuid())
  subject      String
  content      String   // HTML content
  contentPlain String?  // Plain text version
  recipients   String[] // "ALL" or specific institution IDs
  sentBy       String   // Super Admin ID
  sentByName   String   // Super Admin name for reference
  sentAt       DateTime @default(now())
  status       String   @default("SENT")  // DRAFT, SENT, FAILED
  recipientCount Int    @default(0)
  
  @@index([sentBy])
  @@map("broadcast_messages")
}

// ============================================
// SUPPORT TICKETS
// ============================================

enum TicketCategory {
  TECHNICAL
  BILLING
  FEATURE_REQUEST
  BUG_REPORT
  ACCOUNT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model SupportTicket {
  id              String         @id @default(uuid())
  ticketNumber    String         @unique  // "TKT-001234"
  
  // Submitter info
  institutionId   String
  submitterEmail  String
  submitterName   String
  
  // Ticket content
  subject         String
  description     String
  category        TicketCategory @default(OTHER)
  priority        TicketPriority @default(MEDIUM)
  status          TicketStatus   @default(OPEN)
  
  // Assignment
  assignedTo      String?        // Super Admin ID
  assignedToName  String?        // Super Admin name
  
  // Timestamps
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  resolvedAt      DateTime?
  
  // Relations
  responses       TicketResponse[]
  
  @@index([institutionId])
  @@index([status])
  @@index([assignedTo])
  @@map("support_tickets")
}

model TicketResponse {
  id         String        @id @default(uuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  message    String
  authorType String        // "SUPER_ADMIN" or "IT_ADMIN"
  authorId   String
  authorName String
  
  createdAt  DateTime      @default(now())
  
  @@index([ticketId])
  @@map("ticket_responses")
}


