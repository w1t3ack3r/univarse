{
  "name": "@univarse/api",
  "version": "0.0.0",
  "private": true,
  "description": "UniVarse API (NestJS on Fastify). Entrypoints: dist/main.js (HTTP), dist/worker.js (outbox + key sweep worker), dist/cli/keys.js (key operations).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node scripts/dev-run.mjs\"",
    "start": "node --enable-source-maps dist/main.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "keys": "node --enable-source-maps dist/cli/keys.js",
    "openapi": "node --enable-source-maps dist/cli/openapi.js",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-presigned-post": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@univarse/contracts": "workspace:*",
    "@univarse/crypto": "workspace:*",
    "@univarse/db": "workspace:*",
    "@univarse/domain": "workspace:*",
    "fastify": "5.12.5",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.0.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@types/nodemailer": "^7.0.12",
    "ajv": "^8.20.0",
    "tsc-watch": "^7.1.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^4.1.11"
  }
}
