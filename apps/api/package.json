{
  "name": "@univarse/api",
  "version": "0.0.0",
  "private": true,
  "description": "UniVarse API (NestJS on Fastify). Entrypoints: dist/main.js (HTTP), dist/worker.js (jobs, later).",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-fastify": "^11.1.0",
    "@univarse/contracts": "workspace:*",
    "@univarse/db": "workspace:*",
    "@univarse/domain": "workspace:*",
    "fastify": "5.12.5",
    "ioredis": "^5.11.1",
    "nodemailer": "^10.0.11",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@types/nodemailer": "^7.0.12",
    "tsc-watch": "^7.1.0",
    "unplugin-swc": "^1.5.0",
    "vitest": "^4.1.11"
  }
}
