{
  "name": "@univarse/ui",
  "version": "0.0.0",
  "private": true,
  "description": "UniVarse design tokens and base components (docs/11 §3). Source-only; consumed via transpilePackages.",
  "type": "module",
  "exports": {
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./client": "./src/client.tsx",
    ".": "./src/index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build --quiet -o storybook-static",
    "test:stories": "vitest run --project stories",
    "test:a11y-proof": "node --test scripts/a11y-proof.test.mjs && node scripts/a11y-proof.mjs"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^4.1.12",
    "playwright": "^1.63.0",
    "react": "^19",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.3",
    "vitest": "^4.1.12"
  }
}
