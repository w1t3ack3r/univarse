{
  "name": "@univarse/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schemas (platform + tenant), RLS, migrations and tenant-scoped clients.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate --config prisma.platform.config.ts && prisma generate --config prisma.tenant.config.ts",
    "build": "pnpm run generate && tsc -p tsconfig.build.json",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit",
    "setup": "tsx scripts/setup-local.ts",
    "migrate": "prisma migrate deploy --config prisma.platform.config.ts && prisma migrate deploy --config prisma.tenant.config.ts",
    "migrate:new:platform": "prisma migrate dev --create-only --config prisma.platform.config.ts",
    "migrate:new:tenant": "prisma migrate dev --create-only --config prisma.tenant.config.ts",
    "rls:check": "tsx scripts/rls-check.ts",
    "seed": "tsx scripts/seed.ts",
    "test:int": "vitest run --config vitest.int.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@univarse/contracts": "workspace:*",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "vitest": "^4.1.11"
  }
}
