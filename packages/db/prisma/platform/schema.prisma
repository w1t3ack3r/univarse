// Platform (control plane) schema — no tenant personal data lives here.
// Entities: docs/03-domain-model.md §1

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/platform"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum TenantType {
  UNIVERSITY
  POLYTECHNIC
  COLLEGE_OF_EDUCATION
}

enum TenantOwnership {
  FEDERAL
  STATE
  PRIVATE
}

enum TenantStatus {
  REQUESTED
  PROVISIONING
  ONBOARDING
  ACTIVE
  SUSPENDED
  OFFBOARDING
  ARCHIVED
  PURGED
}

enum TenantTier {
  POOLED
  DEDICATED
}

enum ShardKind {
  POOL
  DEDICATED
}

model Shard {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name      String    @unique
  kind      ShardKind
  /// Name of the env var / secret holding the connection string — never the URL itself.
  secretRef String    @map("secret_ref")
  region    String
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  tenants Tenant[]

  @@map("shard")
}

model Tenant {
  id                   String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Immutable; becomes the subdomain.
  slug                 String          @unique
  legalName            String          @map("legal_name")
  shortName            String          @map("short_name")
  type                 TenantType
  ownership            TenantOwnership
  status               TenantStatus    @default(REQUESTED)
  tier                 TenantTier      @default(POOLED)
  shardId              String          @map("shard_id") @db.Uuid
  suspendedReason      String?         @map("suspended_reason")
  offboardingStartedAt DateTime?       @map("offboarding_started_at") @db.Timestamptz(3)
  purgeAfter           DateTime?       @map("purge_after") @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  version              Int             @default(0)

  shard    Shard           @relation(fields: [shardId], references: [id], onDelete: Restrict)
  domains  TenantDomain[]
  products TenantProduct[]
  keyReencryption KeyReencryption?
  dataKeys TenantDataKey[]
  keyDestructions KeyDestruction[]

  @@map("tenant")
}

enum DomainKind {
  SUBDOMAIN
  CUSTOM
}

model TenantDomain {
  id                String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId          String     @map("tenant_id") @db.Uuid
  /// Lower-case host without port, e.g. "unilag.univarse.ng".
  hostname          String     @unique
  kind              DomainKind
  verificationToken String?    @map("verification_token")
  verifiedAt        DateTime?  @map("verified_at") @db.Timestamptz(3)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("tenant_domain")
}

enum PlatformRole {
  OWNER
  SUPER_ADMIN
  SUPPORT
  FINANCE
  READ_ONLY
}

model PlatformUser {
  id           String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String       @unique
  displayName  String       @map("display_name")
  passwordHash String?      @map("password_hash")
  role         PlatformRole
  /// Never used; superseded by PlatformMfaFactor (spec 0028 Q2). Dropped in a later release (expand, then contract).
  totpSecretEnc String?     @map("totp_secret_enc")
  isActive     Boolean      @default(true) @map("is_active")
  lastLoginAt  DateTime?    @map("last_login_at") @db.Timestamptz(3)
  /// Spec 0028 Q9: failed passwords and TOTP codes since the last success; 10 lock the account for 15 minutes.
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil  DateTime?    @map("locked_until") @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions       PlatformSession[]
  mfaFactors     PlatformMfaFactor[]
  recoveryCodes  PlatformRecoveryCode[]
  mfaChallenges  PlatformMfaChallenge[]
  oneTimeCodes   PlatformOneTimeCode[]
  knownDevices   PlatformKnownDevice[]

  @@map("platform_user")
}

/// Spec 0028 Q2, Q3: a member's TOTP factor. The secret is encrypted with the console's own Transit key.
model PlatformMfaFactor {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  secretEnc    String    @map("secret_enc")
  confirmedAt  DateTime? @map("confirmed_at") @db.Timestamptz(3)
  /// Highest accepted TOTP time step: a code for this step or an earlier one is a replay.
  lastUsedStep BigInt?   @map("last_used_step")
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamptz(3)
  /// Set when replaced or reset; the console role has no DELETE (spec 0028 Q2).
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_mfa_factor")
}

/// Spec 0028 Q7: ten single-use recovery codes, hashed with the console's pepper.
model PlatformRecoveryCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  Bytes     @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_recovery_code")
}

/// Spec 0028 Q7: after a correct password, 5 minutes and 5 attempts to give a TOTP or recovery code. Not a session.
model PlatformMfaChallenge {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts  Int       @default(0)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ip        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_mfa_challenge")
}

/// Spec 0028 Q6: emailed 6-digit codes, peppered, 15 minutes, 5 attempts, single use.
model PlatformOneTimeCode {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// ACTIVATION or PASSWORD_RESET (a CHECK constraint).
  purpose   String
  codeHash  Bytes     @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("platform_one_time_code")
}

/// Spec 0028 Q10: browsers a member has signed in from, by the hash of a random id this console set in a cookie.
model PlatformKnownDevice {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  deviceHash  Bytes    @map("device_hash")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceHash])
  @@map("platform_known_device")
}

/// Spec 0028 Q4: the console's mail, written in the transaction of the action it reports and sent by the platform
/// API's own relay. The body is cleared once sent: it may hold a one-time code.
model PlatformMailOutbox {
  id            String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  toAddress     String    @map("to_address")
  subject       String
  body          String
  /// PENDING, SENT or FAILED (a CHECK constraint).
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("platform_mail_outbox")
}

model PlatformSession {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         Bytes     @unique @map("token_hash")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(3)
  mfaAt             DateTime? @map("mfa_at") @db.Timestamptz(3)
  /// Spec 0028 Q7: enrolment-only, for a member without a confirmed TOTP factor.
  restricted        Boolean   @default(false)
  /// Spec 0028 Q11: the last step-up on this session.
  stepUpAt          DateTime? @map("step_up_at") @db.Timestamptz(3)
  ip                String?
  userAgent         String?   @map("user_agent")
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokeReason      String?   @map("revoke_reason")

  user PlatformUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("platform_session")
}

model PlatformAuditEvent {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Position in the single platform hash chain (written under an advisory lock).
  seq        BigInt   @unique
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  tenantId   String?  @map("tenant_id") @db.Uuid
  metadata   Json?
  ip         String?
  prevHash   Bytes    @map("prev_hash")
  hash       Bytes

  keyDestruction KeyDestruction?
  ledgerWaiver   LedgerWaiver?

  @@index([tenantId, occurredAt])
  @@map("platform_audit_event")
}

/// Product entitlements per tenant (ADR-020, spec 0003). Active = entitled AND enabled; `core` always active.
model TenantProduct {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  /// One of packages/contracts PRODUCTS.
  product   String
  /// Granted by UniVarse (plan). Only platform code writes this.
  entitled  Boolean  @default(false)
  /// Switched on by the institution's IT Admin, within the entitlement.
  enabled   Boolean  @default(false)
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, product])
  @@map("tenant_product")
}

enum DataKeyStatus {
  ACTIVE
  RETIRED
  DESTROYED
}

/// Per-tenant data encryption keys, stored only wrapped by the KEK (spec 0006, ADR-023).
/// Kept in the platform DB, apart from tenant data (E2). Never hard-deleted: DESTROYED erases the wrap.
model TenantDataKey {
  id          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  version     Int
  status      DataKeyStatus @default(ACTIVE)
  /// Which KEK wrapped it, e.g. "vault:transit/univarse-kek".
  kekId       String        @map("kek_id")
  /// Provider ciphertext of the DEK (e.g. "vault:v1:…"). NULL once DESTROYED (crypto-shredding, E10).
  wrappedDek  String?       @map("wrapped_dek")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  retiredAt   DateTime?     @map("retired_at") @db.Timestamptz(3)
  destroyedAt DateTime?     @map("destroyed_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, version])
  @@map("tenant_data_key")
}

enum ReencryptionReason {
  ROTATION
  LEGACY_V1
}

/// Spec 0006 E7/E9: a tenant's pending re-encryption sweep (one row per tenant, re-requested in place).
model KeyReencryption {
  tenantId        String             @id @map("tenant_id") @db.Uuid
  reason          ReencryptionReason
  requestedAt     DateTime           @default(now()) @map("requested_at") @db.Timestamptz(3)
  startedAt       DateTime?          @map("started_at") @db.Timestamptz(3)
  /// NULL while pending; a new request clears it.
  completedAt     DateTime?          @map("completed_at") @db.Timestamptz(3)
  rowsReencrypted BigInt             @default(0) @map("rows_reencrypted")
  /// E13: unreadable values the last completed sweep left behind. > 0 ⇒ partial; their key versions are kept.
  unreadableRemaining BigInt         @default(0) @map("unreadable_remaining")
  leaseUntil      DateTime?          @map("lease_until") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@map("key_reencryption")
}

/// Spec 0016 (ADR-031): an invalidation captured by a trigger on tenant, tenant_domain or tenant_product, in the
/// writer's transaction; the worker's relay publishes it. Its partial indexes, functions, guard triggers and grants
/// are hand-written in the migration (20261018120000_cache_invalidation_outbox). Never row values (IO14).
model CacheInvalidationEvent {
  id              String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  channel         String
  tenantId        String    @map("tenant_id") @db.Uuid
  source          String
  createdAt       DateTime  @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  firstObservedAt DateTime? @map("first_observed_at") @db.Timestamptz(6)
  attempts        Int       @default(0)
  nextAttemptAt   DateTime  @default(dbgenerated("clock_timestamp()")) @map("next_attempt_at") @db.Timestamptz(6)
  status          String    @default("PENDING")
  settledAt       DateTime? @map("settled_at") @db.Timestamptz(6)
  lastError       String?   @map("last_error")

  @@map("cache_invalidation_event")
}

enum KeyDestructionKind {
  TENANT
  RETIRED
}

/// Spec 0020 D7/D8/D14: one row per accepted key destruction, in the destruction's own transaction, keyed by the
/// host protocol's operation id. The database's evidence that a destruction committed. Append-only for the app role.
model KeyDestruction {
  op          String             @id @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  kind        KeyDestructionKind
  versions    Int[]
  reason      String
  destroyedAt DateTime           @default(now()) @map("destroyed_at") @db.Timestamptz(3)
  auditSeq    BigInt             @unique @map("audit_seq")

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  auditEvent PlatformAuditEvent @relation(fields: [auditSeq], references: [seq], onDelete: Restrict, onUpdate: Restrict)

  @@index([tenantId])
  @@map("key_destruction")
}

/// Spec 0020 D8's waiver (A3-6): one row per waiver attempt audited, keyed by the host's attempt id, so the waiver's
/// platform audit event is written once. Append-only for the app role.
model LedgerWaiver {
  attemptId String   @id @map("attempt_id") @db.Uuid
  auditSeq  BigInt   @unique @map("audit_seq")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  auditEvent PlatformAuditEvent @relation(fields: [auditSeq], references: [seq], onDelete: Restrict, onUpdate: Restrict)

  @@map("ledger_waiver")
}
