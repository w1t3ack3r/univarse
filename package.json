{
  "name": "univarse",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "dev": "turbo run dev",
    "db:setup": "pnpm --filter @univarse/db run setup",
    "db:migrate": "pnpm --filter @univarse/db run migrate",
    "db:seed": "pnpm --filter @univarse/db run seed",
    "rls:check": "pnpm --filter @univarse/db run rls:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3"
  }
}
