{
  "name": "univarse",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint && eslint tools",
    "test": "turbo run test",
    "test:int": "turbo run test:int --concurrency=1",
    "test:int:pgbouncer": "node tools/pgbouncer/test-int.mjs",
    "dev": "turbo run dev",
    "db:setup": "pnpm --filter @univarse/db run setup",
    "dev:pgbouncer": "node tools/pgbouncer/run.mjs start",
    "db:migrate": "pnpm --filter @univarse/db run migrate",
    "db:seed": "pnpm --filter @univarse/db run seed && pnpm --filter @univarse/crypto run provision",
    "rls:check": "pnpm --filter @univarse/db run rls:check",
    "contracts:gen": "turbo run build --filter=@univarse/api && pnpm --filter @univarse/api openapi && pnpm --filter @univarse/api-client gen",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:secrets": "node tools/dev-secrets.mjs",
    "dev:infra": "node tools/storage-dev.mjs config && docker compose -f infra/compose/compose.dev.yml --env-file .env up -d --wait && node tools/vault-dev.mjs && node tools/storage-dev.mjs buckets",
    "dev:infra:docs": "docker compose -f infra/compose/compose.dev.yml --env-file .env --profile docs up -d",
    "dev:traces": "node tools/traces-dev.mjs",
    "dev:traces:jaeger": "node tools/traces-dev.mjs jaeger",
    "images:release": "node tools/images/release.mjs",
    "images:verify": "node tools/images/verify-release.mjs",
    "images:prune": "node tools/images/prune.mjs",
    "images:proofs": "node tools/images/gate-proofs.mjs",
    "ci:policy": "node tools/ci-policy/workflow-policy.mjs",
    "dev:infra:down": "docker compose -f infra/compose/compose.dev.yml --env-file .env down",
    "test:e2e": "turbo run test:e2e",
    "dev:vault": "node tools/vault-dev.mjs",
    "stack:init": "pnpm --filter @univarse/stack run init",
    "stack:deploy": "pnpm --filter @univarse/stack run deploy",
    "stack:vault": "pnpm --filter @univarse/stack run vault",
    "stack:down": "pnpm --filter @univarse/stack run down",
    "stack:smoke": "pnpm --filter @univarse/stack run smoke",
    "stack:trust": "pnpm --filter @univarse/stack run trust",
    "stack:pools": "pnpm --filter @univarse/stack run pools",
    "stack:e2e": "pnpm --filter @univarse/stack run e2e --",
    "stack:isolation": "pnpm --filter @univarse/stack run isolation"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "js-yaml": "4.3.2",
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "overrides": {
      "fastify": "5.12.5",
      "mysql2": ">=3.23.1 <4",
      "deepmerge-ts": ">=8.0.0 <9",
      "source-map-js": ">=1.2.2 <2",
      "vite": ">=7.3.7 <8"
    }
  }
}
